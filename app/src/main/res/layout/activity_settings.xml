<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:titleTextAppearance="@style/TextAppearance.Labs.MainTitle"
        app:title="@string/title_settings"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.Labs.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_appearance" />

            <LinearLayout
                android:id="@+id/rowLanguage"
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_language" />
                <TextView
                    android:id="@+id/textViewLanguageValue"
                    style="@style/Widget.Labs.SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTheme"
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_theme" />
                <TextView
                    android:id="@+id/textViewThemeValue"
                    style="@style/Widget.Labs.SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Labs.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_pattern" />

            <LinearLayout
                android:id="@+id/rowDirection"
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_reading_direction" />
                <TextView
                    android:id="@+id/textViewDirectionValue"
                    style="@style/Widget.Labs.SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/switchShowRowNumbers"
                    android:text="@string/setting_show_row_numbers" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchShowRowNumbers"
                    style="@style/Widget.Labs.SettingsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="@string/setting_show_row_numbers" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/switchShowGridLines"
                    android:text="@string/setting_show_grid_lines" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchShowGridLines"
                    style="@style/Widget.Labs.SettingsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="@string/setting_show_grid_lines" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Labs.SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_about" />

            <LinearLayout
                style="@style/Widget.Labs.SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewAbout"
                    style="@style/Widget.Labs.SettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />
                <TextView
                    android:id="@+id/textViewVersion"
                    style="@style/Widget.Labs.SettingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
