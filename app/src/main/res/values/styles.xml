<resources>
    <style name="TextAppearance.Labs.MainTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/stitch_sans</item>
        <item name="fontFamily">@font/stitch_sans</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="ShapeAppearanceOverlay.Labs.AddButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Widget.Labs.ColorChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/stitch_sans</item>
        <item name="fontFamily">@font/stitch_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:gravity">center</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/stitch_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
    <style name="Widget.Labs.SettingsSection" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/stitch_sans</item>
        <item name="fontFamily">@font/stitch_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="Widget.Labs.SettingsCard" parent="">
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/background_settings_card</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:clipToOutline">true</item>
    </style>
    <style name="Widget.Labs.SettingsLabel" parent="">
        <item name="android:fontFamily">@font/stitch_sans</item>
        <item name="fontFamily">@font/stitch_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.Labs.SettingsValue" parent="">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">@font/stitch_sans</item>
        <item name="fontFamily">@font/stitch_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.Labs.SettingsSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/settings_switch_track</item>
        <item name="thumbIcon">@null</item>
        <item name="trackDecoration">@null</item>
    </style>
</resources>
